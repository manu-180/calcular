{
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/datos-vivos",
      "schedule": "30 12,19 * * *"
    },
    {
      "path": "/api/cron/recuperar-compras",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/panel-mantenimiento",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/mes-nuevo",
      "schedule": "5 3 1 * *"
    }
  ],
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)*.md' ':(exclude)docs' ':(exclude)marketing' ':(exclude).github' ':(exclude).claude'"
}
